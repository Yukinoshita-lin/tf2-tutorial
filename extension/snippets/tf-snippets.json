  "TF-手写注意力": {
    "prefix": "tf-attention",
    "body": [
      "class SelfAttention(tf.keras.layers.Layer):",
      "    def __init__(self, d_model=32, heads=2, **kw):",
      "        super().__init__(**kw)",
      "        self.h, self.d_k = heads, d_model // heads",
      "        self.wq = tf.keras.layers.Dense(d_model)",
      "        self.wk = tf.keras.layers.Dense(d_model)",
      "        self.wv = tf.keras.layers.Dense(d_model)",
      "        self.wo = tf.keras.layers.Dense(d_model)",
      "",
      "    def call(self, x):",
      "        b = tf.shape(x)[0]",
      "        q = tf.reshape(self.wq(x), (b, -1, self.h, self.d_k))",
      "        k = tf.reshape(self.wk(x), (b, -1, self.h, self.d_k))",
      "        v = tf.reshape(self.wv(x), (b, -1, self.h, self.d_k))",
      "        q, k, v = [tf.transpose(t, (0, 2, 1, 3)) for t in (q, k, v)]",
      "        scores = tf.matmul(q, k, transpose_b=True) / tf.sqrt(tf.cast(self.d_k, tf.float32))",
      "        out = tf.matmul(tf.nn.softmax(scores, axis=-1), v)",
      "        return self.wo(tf.reshape(tf.transpose(out, (0, 2, 1, 3)), (b, -1, self.h * self.d_k)))",
      "$0"
    ],
    "description": "手写多头自注意力（进阶篇 13）"
  },
